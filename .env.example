# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide these credentials to connect LABVERSE to your live Supabase PostgreSQL
# database, Supabase Auth, and Supabase Storage for PDF manuals and diagrams.
# If omitted or blank, LABVERSE runs in functional Local Demo Mode.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# Compatibility variable name used by the app; use the project's sb_publishable_ key as its value.
VITE_SUPABASE_ANON_KEY="your-sb-publishable-key"
# Optional server-side Supabase service-role secret key for trusted administrative auth invites and storage provisioning
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
